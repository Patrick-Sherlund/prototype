# n8n local runtime
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=https://replace-with-your-tunnel.example.com
GENERIC_TIMEZONE=America/Chicago
N8N_ENCRYPTION_KEY=replace-with-a-32-plus-character-random-string
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Figma webhook and handoff configuration
# FIGMA_ACCESS_TOKEN is used only by the webhook registration helper.
# Use FIGMA_ACCESS_TOKEN_TYPE=oauth for a scoped OAuth token, or personal for X-Figma-Token.
FIGMA_ACCESS_TOKEN=
FIGMA_ACCESS_TOKEN_TYPE=oauth
FIGMA_WEBHOOK_PASSCODE=replace-with-random-webhook-passcode
FIGMA_MAKE_FILE_KEY=
FIGMA_MAKE_URL=
FIGMA_MAKE_PUBLISHED_URL=
FIGMA_DESTINATION_FILE_KEY=
FIGMA_DESTINATION_FILE_URL=

# Slack status updates
SLACK_CHANNEL_ID=C0BP62TK3PD
SLACK_CHANNEL_URL=https://sysco-demo.slack.com/archives/C0BP62TK3PD
SLACK_BOT_TOKEN=

# Jira Cloud
JIRA_BASE_URL=https://patricksherlund.atlassian.net
JIRA_PROJECT_KEY=SYSCO
JIRA_AUTH_HEADER=Basic replace-with-base64-email-colon-api-token

# Worker -> n8n callback authentication
N8N_CALLBACK_SECRET=replace-with-a-random-shared-secret

# Local Claude Code worker invoked by n8n.
# On Docker Desktop, n8n reaches the Windows host through host.docker.internal.
LOCAL_WORKER_BIND=0.0.0.0
LOCAL_WORKER_PORT=8787
LOCAL_WORKER_URL=http://host.docker.internal:8787
LOCAL_WORKER_SECRET=replace-with-a-random-local-shared-secret
CLAUDE_COMMAND=

# Claude Code as Figma MCP agent
FIGMA_CLAUDE_MAX_TURNS=16
FIGMA_HANDOFF_TIMEOUT_MS=1200000
FIGMA_CLAUDE_ALLOWED_TOOLS=mcp__figma__*,Read,LS,Bash(npx playwright:*),Bash(npm exec playwright:*)
