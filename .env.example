# n8n local runtime
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=https://replace-with-your-tunnel.example.com
GENERIC_TIMEZONE=America/Chicago
N8N_ENCRYPTION_KEY=replace-with-a-32-plus-character-random-string
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Figma Make source and optional webhook configuration.
# The free-tier MCP-only POC does not require Figma REST webhooks.
FIGMA_WEBHOOK_ENABLED=false
# FIGMA_ACCESS_TOKEN is used only by the optional webhook registration helper.
# Use FIGMA_ACCESS_TOKEN_TYPE=oauth for a scoped OAuth token, or personal for X-Figma-Token.
FIGMA_ACCESS_TOKEN=
FIGMA_ACCESS_TOKEN_TYPE=oauth
FIGMA_WEBHOOK_PASSCODE=
FIGMA_MAKE_FILE_KEY=
FIGMA_MAKE_URL=
FIGMA_MAKE_PUBLISHED_URL=
# Canonical Figma Design file for the full Make sync. If set, all syncs must
# target this file and must not create a new file.
FIGMA_DESIGN_FILE_KEY=
FIGMA_DESIGN_FILE_URL=
FIGMA_SYNC_PAGE_NAME=Figma Make Screens
FIGMA_DESIGN_BOOTSTRAP_ALLOWED=true
FIGMA_ARCHIVE_REMOVED_VIEWS=true
# Backward-compatible aliases from the earlier one-screen POC.
FIGMA_DESTINATION_FILE_KEY=
FIGMA_DESTINATION_FILE_URL=

# Optional shared secret for the request-driven POC endpoint.
FIGMA_HANDOFF_REQUEST_SECRET=

# Slack status updates
SLACK_CHANNEL_ID=C0BP62TK3PD
SLACK_CHANNEL_URL=https://sysco-demo.slack.com/archives/C0BP62TK3PD
SLACK_BOT_TOKEN=

# Jira Cloud
JIRA_BASE_URL=https://patricksherlund.atlassian.net
JIRA_PROJECT_KEY=SYSCO
JIRA_AUTH_HEADER=Basic replace-with-base64-email-colon-api-token

# Worker -> n8n callback authentication
N8N_CALLBACK_SECRET=replace-with-a-random-shared-secret

# Local Claude Code worker invoked by n8n.
# On Docker Desktop, n8n reaches the Windows host through host.docker.internal.
LOCAL_WORKER_BIND=0.0.0.0
LOCAL_WORKER_PORT=8787
LOCAL_WORKER_URL=http://host.docker.internal:8787
LOCAL_WORKER_SECRET=replace-with-a-random-local-shared-secret
CLAUDE_COMMAND=

# Claude Code as Figma MCP agent
FIGMA_CLAUDE_MAX_TURNS=16
FIGMA_HANDOFF_TIMEOUT_MS=1200000
FIGMA_CLAUDE_ALLOWED_TOOLS=mcp__figma__*,Read,LS

# Optional browser diagnostics. Leave disabled for the MCP-only POC.
FIGMA_PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_PACKAGE=@playwright/mcp@latest
PLAYWRIGHT_MCP_BROWSER=chrome
PLAYWRIGHT_MCP_OUTPUT_DIR=.automation/playwright-mcp
PLAYWRIGHT_MCP_TIMEOUT_NAVIGATION=90000
PLAYWRIGHT_MCP_TIMEOUT_ACTION=10000
PLAYWRIGHT_MCP_CONFIG_JSON=
